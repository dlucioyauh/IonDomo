# .env.example - IonDomo
# Criado pela IONKOD | Douglas Lúcio
# NUNCA preencha este arquivo com dados reais. Copie para .env e preencha localmente.

# Backend API
API_BASE_URL=https://api.iondomo.ionkod.com/v1
API_TIMEOUT_MS=5000

# Criptografia (Chaves geradas via scripts seguros, nunca hardcoded)
# Exemplo de formato: ECPublicKey ou AES-GCM 256-bit base64
TELEMETRY_PUBLIC_KEY_BASE64=
ENCRYPTION_SALT=

# Feature Flags
ENABLE_STRICT_MODE=true